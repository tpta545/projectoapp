# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
# Service role: SOLO en servidor. Nunca la expongas con el prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Gemini (Google AI Studio) — generación, verificación, auditoría y embeddings
# Consíguela en https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...
# Opcionales, tienen valor por defecto razonable si se omiten:
# GEMINI_MODEL_GENERACION=gemini-2.5-flash
# GEMINI_MODEL_EMBEDDINGS=gemini-embedding-001
