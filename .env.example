# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
# Service role: SOLO en servidor. Nunca la expongas con el prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# OpenAI — generación de preguntas, verificación, auditoría y embeddings
OPENAI_API_KEY=sk-...
# Opcionales, tienen valor por defecto razonable si se omiten:
# OPENAI_MODEL_GENERACION=gpt-4o-mini
# OPENAI_MODEL_EMBEDDINGS=text-embedding-3-small
