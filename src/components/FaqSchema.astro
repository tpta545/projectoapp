---
interface Props {
  items: { pregunta: string; respuesta: string }[];
}
const { items } = Astro.props;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({
    '@type': 'Question',
    name: item.pregunta,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.respuesta,
    },
  })),
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
