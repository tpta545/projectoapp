---
import { EMPRESA } from '@/lib/empresa';
const mensaje = encodeURIComponent('Hola, necesito información sobre un producto/pieza.');
---

<a
  href={`https://wa.me/${EMPRESA.whatsapp}?text=${mensaje}`}
  target="_blank"
  rel="noopener noreferrer"
  class="fixed bottom-5 right-5 z-40 flex h-14 w-14 items-center justify-center rounded-full bg-[#25D366] text-blanco shadow-lg lg:hidden"
  aria-label="Escribir por WhatsApp a TRADE"
>
  <svg aria-hidden="true" viewBox="0 0 32 32" class="h-7 w-7 fill-current">
    <path d="M16.01 3C9.38 3 4 8.38 4 15.01c0 2.4.7 4.63 1.92 6.51L4 29l7.66-1.87a11.9 11.9 0 0 0 4.35.83h.01c6.63 0 12-5.38 12-12.01C28.02 8.38 22.64 3 16.01 3zm0 21.8c-1.42 0-2.81-.37-4.03-1.07l-.29-.17-4.55 1.11 1.21-4.44-.19-.3a9.7 9.7 0 0 1-1.5-5.18c0-5.42 4.41-9.83 9.85-9.83 2.63 0 5.1 1.03 6.96 2.89a9.77 9.77 0 0 1 2.88 6.95c0 5.43-4.42 9.84-9.84 9.84zm5.4-7.37c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.66.15-.2.3-.76.96-.93 1.16-.17.2-.34.22-.64.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.48-1.76-1.66-2.06-.17-.3-.02-.46.13-.61.14-.14.3-.34.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.66-1.6-.91-2.18-.24-.58-.48-.5-.66-.51h-.56c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.87 1.22 3.07c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.62.71.23 1.35.2 1.86.12.57-.08 1.75-.71 1.99-1.4.25-.68.25-1.27.17-1.4-.07-.12-.27-.2-.57-.35z" />
