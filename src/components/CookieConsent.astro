---
---

<div
  id="cookie-banner"
  class="fixed inset-x-0 bottom-0 z-50 hidden border-t border-gris-borde bg-blanco px-4 py-5 shadow-[0_-4px_16px_rgba(0,0,0,0.12)] sm:px-6"
  role="region"
  aria-label="Aviso de cookies"
>
  <div class="mx-auto flex max-w-6xl flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
    <p class="max-w-3xl text-sm text-negro">
      Usamos cookies necesarias para el funcionamiento de la web y, si lo aceptas, cookies analíticas para medir
      visitas (Google Analytics). No se carga ninguna cookie no esencial sin tu consentimiento. Más información en la
      <a href="/politica-cookies/" class="underline hover:text-rojo">política de cookies</a>.
    </p>
    <div class="flex flex-wrap gap-3">
      <button
        type="button"
        id="cookie-configurar"
        class="border border-negro px-4 py-2.5 text-sm font-semibold text-negro hover:bg-gris-fondo"
      >
        Configurar
      </button>
      <button
        type="button"
        id="cookie-rechazar"
        class="border border-negro px-4 py-2.5 text-sm font-semibold text-negro hover:bg-gris-fondo"
      >
        Rechazar
      </button>
      <button
        type="button"
        id="cookie-aceptar"
        class="bg-rojo px-4 py-2.5 text-sm font-semibold text-blanco hover:bg-rojo-hover"
      >
        Aceptar
      </button>
    </div>
  </div>

  <div id="cookie-panel" class="mx-auto mt-4 hidden max-w-6xl border-t border-gris-borde pt-4">
    <div class="flex items-start justify-between gap-4 py-2">
      <div>
        <p class="text-sm font-semibold text-negro">Necesarias</p>
        <p class="text-xs text-grafito">Imprescindibles para la navegación y el envío de formularios. Siempre activas.</p>
      </div>
      <input type="checkbox" checked disabled aria-label="Cookies necesarias, siempre activas" class="mt-1 h-4 w-4" />
    </div>
    <div class="flex items-start justify-between gap-4 border-t border-gris-borde py-2">
      <div>
        <p class="text-sm font-semibold text-negro">Analíticas (Google Analytics 4)</p>
        <p class="text-xs text-grafito">Miden páginas visitadas y origen del tráfico de forma agregada.</p>
      </div>
      <input type="checkbox" id="cookie-analiticas" aria-label="Aceptar cookies analíticas" class="mt-1 h-4 w-4" />
    </div>
    <div class="mt-4 flex justify-end">
      <button
        type="button"
        id="cookie-guardar"
        class="bg-rojo px-4 py-2 text-sm font-semibold text-blanco hover:bg-rojo-hover"
      >
        Guardar preferencias
      </button>
    </div>
  </div>
</div>

<script>
  type Consentimiento = { necesarias: true; analiticas: boolean; fecha: string };
  const CLAVE = 'trade-consentimiento-cookies';

  const banner = document.getElementById('cookie-banner');
  const panel = document.getElementById('cookie-panel');
  const casillaAnaliticas = document.getElementById('cookie-analiticas') as HTMLInputElement | null;

  function leerConsentimiento(): Consentimiento | null {
    try {
      const raw = localStorage.getItem(CLAVE);
      return raw ? (JSON.parse(raw) as Consentimiento) : null;
    } catch {
      return null;
    }
  }

  function guardarConsentimiento(analiticas: boolean) {
    const valor: Consentimiento = { necesarias: true, analiticas, fecha: new Date().toISOString() };
    localStorage.setItem(CLAVE, JSON.stringify(valor));
    document.dispatchEvent(new CustomEvent('trade:consentimiento', { detail: valor }));
    banner?.classList.add('hidden');
  }

  const existente = leerConsentimiento();
  if (!existente) {
    banner?.classList.remove('hidden');
  } else {
    document.dispatchEvent(new CustomEvent('trade:consentimiento', { detail: existente }));
  }

  document.getElementById('cookie-aceptar')?.addEventListener('click', () => guardarConsentimiento(true));
  document.getElementById('cookie-rechazar')?.addEventListener('click', () => guardarConsentimiento(false));
  document.getElementById('cookie-configurar')?.addEventListener('click', () => {
    panel?.classList.toggle('hidden');
  });
  document.getElementById('cookie-guardar')?.addEventListener('click', () => {
    guardarConsentimiento(Boolean(casillaAnaliticas?.checked));
  });
</script>
