---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import CookieConsent from '@/components/CookieConsent.astro';
import Analytics from '@/components/Analytics.astro';
import WhatsAppFloat from '@/components/WhatsAppFloat.astro';
import JsonLdOrganization from '@/components/JsonLdOrganization.astro';
import { EMPRESA } from '@/lib/empresa';
import '@/styles/global.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  noindex?: boolean;
}

const { title, description, ogImage = '/imagenes/og-trade.webp', noindex = false } = Astro.props;

const canonical = new URL(Astro.url.pathname, EMPRESA.urlBase).toString();
const tituloCompleto = title.includes('TRADE') ? title : `${title} | TRADE`;
---

<!doctype html>
<html lang="es-ES">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,follow" />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="TRADE — Transmisiones del Este" />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, EMPRESA.urlBase).toString()} />
    <meta property="og:locale" content="es_ES" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={tituloCompleto} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, EMPRESA.urlBase).toString()} />

    <JsonLdOrganization />
    <Analytics />
  </head>
  <body class="flex min-h-screen flex-col font-sans text-negro">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:absolute focus:left-2 focus:top-2 focus:z-50 focus:bg-rojo focus:px-4 focus:py-2 focus:text-blanco"
    >
      Saltar al contenido
    </a>
    <Header />
    <main id="contenido" class="flex-1">
      <slot />
    </main>
    <Footer />
    <WhatsAppFloat />
    <CookieConsent />
  </body>
</html>
