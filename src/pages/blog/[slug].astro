---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import CtaPresupuesto from '@/components/CtaPresupuesto.astro';
import { formatearFecha } from '@/lib/fechas';
import { categoriaASlug } from '@/lib/blog';
import { EMPRESA } from '@/lib/empresa';

export async function getStaticPaths() {
  const entradas = await getCollection('blog');
  return entradas.map((entrada) => ({
    params: { slug: entrada.id },
    props: { entrada },
  }));
}

const { entrada } = Astro.props;
const { Content, headings } = await render(entrada);
const indice = headings.filter((h) => h.depth === 2);

const relacionados = (
  await Promise.all(entrada.data.relacionados.map((id) => getEntry('blog', id)))
).filter((r) => r !== undefined);

const categoriaSlug = categoriaASlug(entrada.data.categoria);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: entrada.data.titulo,
  description: entrada.data.resumen,
  image: new URL(entrada.data.imagen, EMPRESA.urlBase).toString(),
  author: { '@type': 'Organization', name: entrada.data.autor },
  publisher: { '@type': 'Organization', name: 'TRADE — Transmisiones del Este, S.L.' },
  datePublished: entrada.data.fechaPublicacion.toISOString(),
  dateModified: (entrada.data.fechaActualizacion ?? entrada.data.fechaPublicacion).toISOString(),
  mainEntityOfPage: `${EMPRESA.urlBase}/blog/${entrada.id}/`,
};
---

<BaseLayout title={entrada.data.seo.title} description={entrada.data.seo.description} ogImage={entrada.data.imagen}>
  <Breadcrumbs
    items={[
      { nombre: 'Blog', href: '/blog/' },
      { nombre: entrada.data.categoria, href: `/blog/categoria/${categoriaSlug}/` },
      { nombre: entrada.data.titulo, href: `/blog/${entrada.id}/` },
    ]}
  />

  <header class="border-b border-gris-borde bg-gris-fondo py-10">
    <div class="mx-auto max-w-4xl px-4 sm:px-6">
      <a href={`/blog/categoria/${categoriaSlug}/`} class="text-xs font-semibold uppercase tracking-wide text-rojo hover:underline">
        {entrada.data.categoria}
      </a>
      <h1 class="mt-2 font-display text-3xl font-black text-negro sm:text-4xl">{entrada.data.titulo}</h1>
      <p class="mt-3 text-lg text-grafito">{entrada.data.resumen}</p>
      <div class="mt-4 flex flex-wrap items-center gap-3 text-sm text-grafito">
        <span>{entrada.data.autor}</span>
        <span aria-hidden="true">·</span>
        <time datetime={entrada.data.fechaPublicacion.toISOString()}>Publicado el {formatearFecha(entrada.data.fechaPublicacion)}</time>
        {
          entrada.data.fechaActualizacion && (
            <>
              <span aria-hidden="true">·</span>
              <time datetime={entrada.data.fechaActualizacion.toISOString()}>Actualizado el {formatearFecha(entrada.data.fechaActualizacion)}</time>
            </>
          )
        }
        <span aria-hidden="true">·</span>
        <span>{entrada.data.tiempoLectura} min de lectura</span>
      </div>
    </div>
  </header>

  <img
    src={entrada.data.imagen}
    alt={entrada.data.imagenAlt}
    class="h-64 w-full object-cover sm:h-96"
    width="1200"
    height="600"
  />

  <div class="mx-auto max-w-4xl gap-10 px-4 py-10 sm:px-6 lg:grid lg:grid-cols-[1fr_240px] lg:items-start">
    <article class="prose-trade max-w-none">
      <Content />

      <CtaPresupuesto
        titulo="¿Necesitas esta pieza para tu equipo?"
        texto="Envíanos la referencia o describe la avería y te respondemos con presupuesto en el mismo día hábil."
      />
    </article>

    {
      indice.length > 0 && (
        <nav aria-label="Índice de contenidos" class="order-first mb-8 border border-gris-borde bg-gris-fondo p-5 lg:sticky lg:top-24 lg:order-none lg:mb-0">
          <p class="font-display text-sm font-bold uppercase tracking-wide text-negro">Índice</p>
          <ul class="mt-3 space-y-2 text-sm">
            {indice.map((h) => (
              <li>
                <a href={`#${h.slug}`} class="text-grafito hover:text-rojo">
                  {h.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </div>

  {
    relacionados.length > 0 && (
      <section class="border-t border-gris-borde bg-gris-fondo py-12">
        <div class="mx-auto max-w-6xl px-4 sm:px-6">
          <h2 class="font-display text-2xl font-bold text-negro">Artículos relacionados</h2>
          <ul class="mt-6 grid gap-6 md:grid-cols-3">
            {relacionados.map((r) => (
              <li class="border border-gris-borde bg-blanco">
                <img src={r.data.imagen} alt={r.data.imagenAlt} loading="lazy" class="h-36 w-full object-cover" width="400" height="180" />
                <div class="p-4">
                  <p class="text-xs font-semibold uppercase tracking-wide text-rojo">{r.data.categoria}</p>
                  <h3 class="mt-1 font-display text-base font-bold text-negro">
                    <a href={`/blog/${r.id}/`} class="hover:underline">
                      {r.data.titulo}
                    </a>
                  </h3>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
</BaseLayout>
