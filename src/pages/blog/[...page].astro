---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { formatearFecha } from '@/lib/fechas';
import { categoriaASlug } from '@/lib/blog';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = (await getCollection('blog')).sort(
    (a, b) => b.data.fechaPublicacion.valueOf() - a.data.fechaPublicacion.valueOf(),
  );
  return paginate(posts, { pageSize: 6 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const categorias = [...new Set((await getCollection('blog')).map((p) => p.data.categoria))];
---

<BaseLayout
  title="Blog técnico | TRADE"
  description="Mantenimiento industrial, selección de componentes y diagnóstico de averías. Artículos técnicos de TRADE para plantas de la Ribera Alta y Baixa."
>
  <Breadcrumbs items={[{ nombre: 'Blog', href: '/blog/' }]} />

  <header class="border-b border-gris-borde bg-gris-fondo py-10">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <h1 class="font-display text-4xl font-black text-negro sm:text-5xl">Blog técnico</h1>
      <p class="mt-3 max-w-2xl text-lg text-grafito">
        Selección de componentes, diagnóstico de averías y mantenimiento industrial, escrito por el equipo
        técnico de TRADE.
      </p>
      <ul class="mt-5 flex flex-wrap gap-2">
        {
          categorias.map((c) => (
            <li>
              <a href={`/blog/categoria/${categoriaASlug(c)}/`} class="border border-gris-borde bg-blanco px-3 py-1.5 text-xs font-semibold text-negro hover:border-rojo hover:text-rojo">
                {c}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </header>

  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        page.data.map((post) => (
          <li class="border border-gris-borde bg-blanco">
            <img src={post.data.imagen} alt={post.data.imagenAlt} loading="lazy" class="h-44 w-full object-cover" width="400" height="240" />
            <div class="p-5">
              <p class="text-xs font-semibold uppercase tracking-wide text-rojo">{post.data.categoria}</p>
              <h2 class="mt-2 font-display text-lg font-bold text-negro">
                <a href={`/blog/${post.id}/`} class="hover:underline">
                  {post.data.titulo}
                </a>
              </h2>
              <p class="mt-2 text-sm text-grafito">{post.data.resumen}</p>
              <p class="mt-3 text-xs text-grafito">
                {formatearFecha(post.data.fechaPublicacion)} · {post.data.tiempoLectura} min de lectura
              </p>
            </div>
          </li>
        ))
      }
    </ul>

    {
      (page.url.prev || page.url.next) && (
        <nav aria-label="Paginación" class="mt-10 flex justify-between border-t border-gris-borde pt-6">
          {page.url.prev ? (
            <a href={page.url.prev} class="text-sm font-semibold text-rojo hover:underline">
              ← Más recientes
            </a>
          ) : <span />}
          {page.url.next && (
            <a href={page.url.next} class="text-sm font-semibold text-rojo hover:underline">
              Más antiguos →
            </a>
          )}
        </nav>
      )
    }
  </section>
</BaseLayout>
