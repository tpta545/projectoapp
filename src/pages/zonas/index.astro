---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';

const zonas = await getCollection('zonas');
---

<BaseLayout
  title="Zonas de reparto | TRADE Algemesí"
  description="Reparto propio de TRADE en Algemesí, Alzira, Sueca, Carcaixent y Xàtiva. Cobertura industrial en la Ribera Alta y Ribera Baixa."
>
  <Breadcrumbs items={[{ nombre: 'Zonas', href: '/zonas/' }]} />

  <header class="border-b border-gris-borde bg-gris-fondo py-10">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <h1 class="font-display text-4xl font-black text-negro sm:text-5xl">Zonas de cobertura</h1>
      <p class="mt-3 max-w-2xl text-lg text-grafito">
        Reparto propio, sin agencia externa, en la Ribera Alta, Ribera Baixa y comarcas limítrofes.
      </p>
    </div>
  </header>

  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        zonas.map((z) => (
          <li>
            <a href={`/zonas/${z.id}/`} class="muesca block h-full border border-gris-borde bg-blanco p-6 transition-colors hover:border-rojo">
              <h2 class="font-display text-xl font-bold text-negro">{z.data.localidad}</h2>
              <p class="mt-2 text-sm leading-relaxed text-grafito">{z.data.resumen}</p>
              <span class="mt-4 inline-block font-mono text-sm font-semibold text-rojo">{z.data.tiempoReparto}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
