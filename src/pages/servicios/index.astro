---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';

const servicios = (await getCollection('servicios')).sort((a, b) => a.data.orden - b.data.orden);
---

<BaseLayout
  title="Servicios | TRADE Algemesí"
  description="Reparación de equipos con informe técnico, asesoramiento técnico y reparto propio en la Ribera Alta y Ribera Baixa. TRADE, Algemesí."
>
  <Breadcrumbs items={[{ nombre: 'Servicios', href: '/servicios/' }]} />

  <header class="border-b border-gris-borde bg-gris-fondo py-10">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <h1 class="font-display text-4xl font-black text-negro sm:text-5xl">Servicios</h1>
      <p class="mt-3 max-w-2xl text-lg text-grafito">
        Más allá del suministro de componente: diagnóstico y reparación con informe técnico, asesoramiento por
        personal del sector y reparto propio en la comarca.
      </p>
    </div>
  </header>

  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <ul class="grid gap-6 md:grid-cols-3">
      {
        servicios.map((s) => (
          <li>
            <a
              href={`/servicios/${s.id}/`}
              class={`muesca block h-full border p-6 transition-colors ${s.data.destacado ? 'border-rojo bg-negro text-blanco' : 'border-gris-borde bg-blanco hover:border-rojo'}`}
            >
              {s.data.destacado && (
                <span class="mb-2 inline-block border border-rojo px-2 py-0.5 text-xs font-semibold uppercase tracking-wide text-rojo">
                  Servicio destacado
                </span>
              )}
              <h2 class={`font-display text-2xl font-bold ${s.data.destacado ? 'text-blanco' : 'text-negro'}`}>{s.data.titulo}</h2>
              <p class={`mt-2 text-sm leading-relaxed ${s.data.destacado ? 'text-gray-300' : 'text-grafito'}`}>{s.data.resumen}</p>
              <span class={`mt-4 inline-block text-sm font-semibold ${s.data.destacado ? 'text-rojo' : 'text-rojo'}`}>Ver servicio →</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
