---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import CtaPresupuesto from '@/components/CtaPresupuesto.astro';

export async function getStaticPaths() {
  const entradas = (await getCollection('servicios')).filter((e) => e.id !== 'reparacion-equipos');
  return entradas.map((entrada) => ({
    params: { slug: entrada.id },
    props: { entrada },
  }));
}

const { entrada } = Astro.props;
const { Content } = await render(entrada);
---

<BaseLayout title={entrada.data.seo.title} description={entrada.data.seo.description}>
  <Breadcrumbs items={[{ nombre: 'Servicios', href: '/servicios/' }, { nombre: entrada.data.titulo, href: `/servicios/${entrada.id}/` }]} />

  <header class="border-b border-gris-borde bg-gris-fondo py-10">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <h1 class="font-display text-4xl font-black text-negro sm:text-5xl">{entrada.data.titulo}</h1>
      <p class="mt-3 max-w-2xl text-lg text-grafito">{entrada.data.resumen}</p>
    </div>
  </header>

  <div class="mx-auto max-w-6xl gap-10 px-4 py-10 sm:px-6 lg:grid lg:grid-cols-[2fr_1fr] lg:items-start">
    <article class="prose-trade max-w-none">
      <Content />
    </article>
    <aside class="mt-10 lg:sticky lg:top-24 lg:mt-0">
      <CtaPresupuesto />
    </aside>
  </div>
</BaseLayout>
