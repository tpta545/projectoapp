---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';

const marcas = (await getCollection('marcas')).sort((a, b) => a.data.orden - b.data.orden);
---

<BaseLayout
  title="Marcas | Distribuidor oficial | TRADE"
  description="Distribuidor oficial ABB, FESTO, Dodge, ISB y Tellure Rota en Algemesí. Motores, neumática, transmisión, rodamientos y ruedas industriales."
>
  <Breadcrumbs items={[{ nombre: 'Marcas', href: '/marcas/' }]} />

  <header class="border-b border-gris-borde bg-gris-fondo py-10">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <h1 class="font-display text-4xl font-black text-negro sm:text-5xl">Marcas</h1>
      <p class="mt-3 max-w-2xl text-lg text-grafito">
        Distribución oficial de cinco fabricantes de referencia. Trabajamos con su documentación técnica y
        podemos gestionar directamente con ellos cualquier referencia fuera de nuestro stock propio.
      </p>
    </div>
  </header>

  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        marcas.map((m) => (
          <li>
            <a href={`/marcas/${m.id}/`} class="muesca block h-full border border-gris-borde bg-blanco p-6 transition-colors hover:border-rojo">
              <h2 class="font-display text-2xl font-bold text-negro">{m.data.nombre}</h2>
              <p class="mt-2 text-sm leading-relaxed text-grafito">{m.data.resumen}</p>
              <span class="mt-4 inline-block text-sm font-semibold text-rojo">Ver marca →</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
