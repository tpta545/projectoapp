---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import FaqSchema from '@/components/FaqSchema.astro';
import CtaPresupuesto from '@/components/CtaPresupuesto.astro';
import { MARCAS_OFICIALES } from '@/lib/empresa';

export async function getStaticPaths() {
  const entradas = await getCollection('productos');
  return entradas.map((entrada) => ({
    params: { slug: entrada.id },
    props: { entrada },
  }));
}

const { entrada } = Astro.props;
const { Content } = await render(entrada);
const marcasRelacionadas = MARCAS_OFICIALES.filter((m) => entrada.data.marcas.includes(m.slug));

const otrasFamilias = (await getCollection('productos'))
  .filter((p) => p.id !== entrada.id)
  .sort((a, b) => a.data.orden - b.data.orden)
  .slice(0, 4);
---

<BaseLayout title={entrada.data.seo.title} description={entrada.data.seo.description}>
  <Breadcrumbs items={[{ nombre: 'Productos', href: '/productos/' }, { nombre: entrada.data.titulo, href: `/productos/${entrada.id}/` }]} />

  <header class="border-b border-gris-borde bg-gris-fondo py-10">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <h1 class="font-display text-4xl font-black text-negro sm:text-5xl">{entrada.data.titulo}</h1>
      <p class="mt-3 max-w-2xl text-lg text-grafito">{entrada.data.resumen}</p>
    </div>
  </header>

  <div class="mx-auto max-w-6xl gap-10 px-4 py-10 sm:px-6 lg:grid lg:grid-cols-[2fr_1fr] lg:items-start">
    <article class="prose-trade max-w-none">
      <Content />

      <h2 class="mt-10 font-display text-2xl font-bold text-negro">Marcas disponibles en {entrada.data.titulo.toLowerCase()}</h2>
      <ul class="mt-3 flex flex-wrap gap-3 not-prose">
        {
          marcasRelacionadas.map((m) => (
            <li>
              <a href={`/marcas/${m.slug}/`} class="border border-gris-borde px-4 py-2 text-sm font-semibold text-negro hover:border-rojo hover:text-rojo">
                {m.nombre}
              </a>
            </li>
          ))
        }
      </ul>

      <h2 class="mt-10 font-display text-2xl font-bold text-negro">Criterios de selección</h2>
      <p class="text-grafito">Estos son los datos que necesitamos para preparar un presupuesto correcto a la primera.</p>
      <div class="mt-4 overflow-x-auto not-prose">
        <table class="w-full border-collapse text-sm">
          <thead>
            <tr class="muesca bg-negro text-left text-blanco">
              <th class="px-4 py-3 font-display font-semibold">Dato necesario</th>
              <th class="px-4 py-3 font-display font-semibold">Por qué lo pedimos</th>
            </tr>
          </thead>
          <tbody>
            {
              entrada.data.criterios.map((c, i) => (
                <tr class={i % 2 === 0 ? 'bg-gris-fondo' : 'bg-blanco'}>
                  <td class="border-t border-gris-borde px-4 py-3 font-medium text-negro">{c.dato}</td>
                  <td class="border-t border-gris-borde px-4 py-3 text-grafito">{c.porque}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <h2 class="mt-10 font-display text-2xl font-bold text-negro">Preguntas frecuentes</h2>
      <dl class="mt-4 divide-y divide-gris-borde border-t border-gris-borde not-prose">
        {
          entrada.data.faq.map((f) => (
            <div class="py-4">
              <dt class="font-display text-lg font-bold text-negro">{f.pregunta}</dt>
              <dd class="mt-2 text-grafito">{f.respuesta}</dd>
            </div>
          ))
        }
      </dl>
    </article>

    <aside class="mt-10 space-y-6 lg:sticky lg:top-24 lg:mt-0">
      <CtaPresupuesto
        familia={entrada.id}
        titulo="Pide presupuesto de esta familia"
        texto="Indica la referencia o describe la pieza. Preseleccionamos esta familia en el formulario."
      />
      <div class="border border-gris-borde p-5">
        <p class="font-display text-sm font-bold uppercase tracking-wide text-negro">Otras familias</p>
        <ul class="mt-3 space-y-2 text-sm">
          {
            otrasFamilias.map((p) => (
              <li>
                <a href={`/productos/${p.id}/`} class="text-grafito hover:text-rojo">
                  {p.data.titulo}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </aside>
  </div>

  <FaqSchema items={entrada.data.faq} />
</BaseLayout>
